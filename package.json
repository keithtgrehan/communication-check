{
  "name": "communication-check-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/project.mjs setup",
    "handoff": "node scripts/project.mjs handoff",
    "validate:setup": "node scripts/project.mjs validate && node --test scripts/tests/*.test.mjs",
    "dev": "vite --config web/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config web/vite.config.ts && node scripts/check-build.mjs",
    "preview": "node scripts/serve-preview.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "validate": "npm run validate:setup && npm run test && npm run build && npm run test:browser",
    "verify:hosted": "node scripts/verify-hosted.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
